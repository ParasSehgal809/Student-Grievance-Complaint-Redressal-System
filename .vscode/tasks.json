{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Web App (Jetty Server)",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Build WAR Package",
            "type": "shell",
            "command": "${workspaceFolder}/run.sh clean package",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
